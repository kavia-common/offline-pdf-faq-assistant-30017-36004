# Storage directories
BASE_DIR=./storage
UPLOAD_DIR=./storage/uploads
INDEX_DIR=./storage/index

# RAG params
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
SENTENCE_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# API/CORS
CORS_ALLOW_ORIGINS=*

# Optional: set to enable OpenAI-based summarization during query
# Do not commit your real key. The orchestrator will set environment variables for deployments.
OPENAI_API_KEY=
