# Offline PDF FAQ Chatbot Backend - Environment Variables
# Ocean Professional: defaults aim for clean local operation.

# Base directory for storage (uploads and index)
BASE_DIR=./storage
UPLOAD_DIR=./storage/uploads
INDEX_DIR=./storage/index

# CORS allow origins (comma-separated). Use "*" for all.
CORS_ALLOW_ORIGINS=*

# RAG parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4

# Embeddings
SENTENCE_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Response toggles
INCLUDE_SCORES=true
